# ---- external data APIs (leave EMPTY if you have no key; placeholders are ignored anyway) ----
OPENALEX_API_KEY=
S2_API_KEY=

# ---- Mongo / auth ----
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=research_assistant
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=60
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# ---- Redis (empty = caching disabled, app still works). Upstash: rediss://default:<pw>@<host>:6379
REDIS_URL=
EXTRACTOR_VERSION=v1

# ---- ML: stub (no models, keyword heuristics) | remote (Colab model server) | local (in-process)
ML_BACKEND=stub
ML_REMOTE_URL=
ML_SERVICE_TOKEN=
# EMBED_BACKEND defaults to: stub->hashing, remote->remote, local->local
INTENT_MIN_CONF=0.6
EXTRACT_ON_CHAT=false
EXTRACTOR_TIMEOUT_S=20

# ---- chat/report LLM (any OpenAI-compatible API). Check the provider's CURRENT model list. ----
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_CHAT_MODEL=
LLM_REPORT_MODEL=
LLM_FALLBACK_MODEL=

# ---- pipeline / debugging ----
RAG_MODE=hybrid
RATE_LIMIT_PER_MIN=20
DEBUG=false
TRACE_STORE_TEXT=true
